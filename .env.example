# Handshake configuration. Copy to .env (scripts/dev.py does this for you on first run
# and generates the secrets below). .env is gitignored; never commit it.
# Every value is read by handshake/config.py and nowhere else.

# ---- Environment and public URLs (change these when moving to the real domain) ----
HANDSHAKE_ENV=dev
HANDSHAKE_API_URL=http://localhost:8000
HANDSHAKE_FRONTEND_URL=http://localhost:3000
HANDSHAKE_MERCHANT_URL=http://localhost:3001
# Comma list. Default: the frontend and merchant URLs. No wildcard allowed in prod.
HANDSHAKE_CORS_ORIGINS=
# Comma list of checkout origins the extractor may fetch. Default: the merchant URL.
HANDSHAKE_ALLOWED_MERCHANT_ORIGINS=
# Which merchant each checkout origin belongs to (origin=Name;origin=Name). Default: merchant URL = Amazon.com (the mock store).
HANDSHAKE_MERCHANT_IDENTITIES=
# Dev runner ports (default: taken from the URLs above)
HANDSHAKE_API_PORT=
HANDSHAKE_FRONTEND_PORT=
HANDSHAKE_MERCHANT_PORT=

# ---- Storage ----
DATABASE_URL=sqlite:///./handshake.db

# ---- Secrets (leave blank; scripts/dev.py generates random values into .env) ----
HANDSHAKE_SIGNING_SECRET=
HANDSHAKE_SESSION_SECRET=
HANDSHAKE_AGENT_TOKEN=
HANDSHAKE_MCP_HTTP_TOKEN=

# ---- The agent ----
HANDSHAKE_AGENT_OWNER=demo@handshake.dev
HANDSHAKE_AGENT_ID=agent_demo
HANDSHAKE_AGENT_TOKEN_TTL_DAYS=7
HANDSHAKE_DEVICE_CODE_TTL_MINUTES=10
# Where the MCP server caches the token it gets from the login-link (device) flow
HANDSHAKE_MCP_TOKEN_FILE=

# ---- Payments: ONLY "stub" (offline, simulated) or "link_test" (Stripe Link TEST MODE) ----
HANDSHAKE_PAYMENT_MODE=stub
# agent_visible (default: the agent receives the single-use TEST card) or executor (the backend pays)
HANDSHAKE_CREDENTIAL_MODE=agent_visible
HANDSHAKE_LINK_CLI=npx --yes @stripe/link-cli@0.23.0
HANDSHAKE_LINK_MAX_MINOR_UNITS=50000
HANDSHAKE_LINK_TIMEOUT_SECONDS=60
HANDSHAKE_LINK_TMP_DIR=
HANDSHAKE_CREDENTIAL_TTL_MINUTES=30

# ---- Contract compiler (drafts only; never decides anything) ----
# openai (falls back to the offline fixture when no key is set) or fixture
HANDSHAKE_COMPILER=openai
HANDSHAKE_COMPILER_MODEL=gpt-5.6
HANDSHAKE_COMPILER_SERVICE_TIER=
HANDSHAKE_COMPILER_TIMEOUT_SECONDS=60
# Paste your own key into .env (never here)
OPENAI_API_KEY=

# ---- Behavior ----
HANDSHAKE_USER_TIMEZONE=America/New_York
HANDSHAKE_ESCALATION_TTL_MINUTES=30
HANDSHAKE_SESSION_TTL_MINUTES=720
HANDSHAKE_HTTP_TIMEOUT_SECONDS=10
HANDSHAKE_MAX_CHECKOUT_BYTES=524288
