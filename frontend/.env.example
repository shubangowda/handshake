# Copy to .env.local (scripts/dev.py writes .env.local for you) and restart `npm run dev`.
# Placeholders only: never put secrets in this file. NEXT_PUBLIC_* values are visible in the browser.

# Where the Handshake FastAPI backend runs. Required when mocks are off.
NEXT_PUBLIC_API_URL=http://localhost:8000

# false = talk to the backend above. true (or unset) = in-memory mock data, no backend needed.
NEXT_PUBLIC_USE_MOCKS=false

# Public MCP server URL (for example https://<your-app>.fly.dev/mcp). Shown on /agents as "Connect Muse".
# Leave empty to hide that help box.
NEXT_PUBLIC_MCP_URL=
